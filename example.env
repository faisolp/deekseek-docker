# ไฟล์ Environment Variables ตัวอย่างสำหรับ DeepSeek-R1-Thai
# คัดลอกเป็น .env และปรับแต่งตามต้องการ

#-----------------------------------------------------------------------
# กำหนดรุ่นของโมเดล และชื่อ
#-----------------------------------------------------------------------
# เลือกรุ่นโมเดล (เช่น deepseek-r1:8b, deepseek-r1:14b, deepseek-coder)
MODEL_NAME=deepseek-r1:8b
# ชื่อที่ต้องการตั้งสำหรับโมเดลที่ปรับแต่งแล้ว
MODEL_ALIAS=deepseek-r1-thai



#-----------------------------------------------------------------------
# ค่า Colima (สำหรับผู้ใช้ Colima แทน Docker Desktop)
#-----------------------------------------------------------------------
# จำนวน CPU cores สำหรับ Colima VM
COLIMA_CPU=4
# ปริมาณหน่วยความจำสำหรับ Colima VM (ควรมากกว่าความต้องการรวมของ containers)
COLIMA_MEMORY=10
# ปริมาณพื้นที่ดิสก์สำหรับ Colima VM
COLIMA_DISK=100

#-----------------------------------------------------------------------
# ทรัพยากรสำหรับ Ollama
#-----------------------------------------------------------------------
# จำนวน CPU cores ที่จะใช้ (ต้องไม่เกินจำนวน CPU ที่มีในเครื่อง)
OLLAMA_CPU=3.5
# ปริมาณหน่วยความจำที่จะใช้ (8G สำหรับรุ่น 8B, 13G สำหรับรุ่น 14B)
OLLAMA_MEMORY=8G
# จำนวน layers ที่จะประมวลผลบน GPU
OLLAMA_GPU_LAYERS=40

#-----------------------------------------------------------------------
# ทรัพยากรสำหรับ WebUI
#-----------------------------------------------------------------------
# จำนวน CPU cores สำหรับ WebUI
WEBUI_CPU=0.5
# ปริมาณหน่วยความจำสำหรับ WebUI
WEBUI_MEMORY=2G

#-----------------------------------------------------------------------
# ค่า parameters สำหรับโมเดล
#-----------------------------------------------------------------------
# ค่าความสร้างสรรค์ (0.1-1.0: ต่ำ = แม่นยำ, สูง = สร้างสรรค์)
MODEL_TEMPERATURE=0.7
# ค่า Nucleus sampling (0.1-1.0: ต่ำ = ทางเลือกน้อย, สูง = หลากหลาย)
MODEL_TOP_P=0.9
# จำนวนโทเค็นที่จะพิจารณาในแต่ละขั้นตอน
MODEL_TOP_K=40


#-----------------------------------------------------------------------
# ข้อมูลสำหรับ WebUI
#-----------------------------------------------------------------------
# ชื่อผู้ใช้สำหรับ WebUI
WEBUI_USER=admin
# รหัสผ่านสำหรับ WebUI
WEBUI_PASS=adminpass
# พอร์ตสำหรับเข้าถึง WebUI
WEBUI_PORT=3000

#-----------------------------------------------------------------------
# ตัวเลือกการตั้งค่าโมเดลอื่นๆ
#-----------------------------------------------------------------------
# ตัวอย่างการใช้ deepseek-coder
# MODEL_NAME=deepseek-coder
# MODEL_ALIAS=deepseek-coder-thai

# ตัวอย่างการใช้ DeepSeek-R1 14B (ต้องการ RAM มากกว่า)
# MODEL_NAME=deepseek-r1:14b
# MODEL_ALIAS=deepseek-r1-thai-14b
# OLLAMA_MEMORY=13G
# COLIMA_MEMORY=15

# ตัวอย่างการใช้ Llama 3
# MODEL_NAME=llama3
# MODEL_ALIAS=llama3-thai