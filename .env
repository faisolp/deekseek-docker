# ไฟล์ Environment Variables สำหรับ DeepSeek-V2-Thai

# กำหนดรุ่นของโมเดล DeepSeek
MODEL_NAME=deepseek-v2:16b
MODEL_ALIAS=deepseek-v2-thai

# ค่า Colima
COLIMA_CPU=6
COLIMA_MEMORY=10
COLIMA_DISK=100

# ทรัพยากรสำหรับ Ollama
OLLAMA_CPU=4
OLLAMA_MEMORY=8G
OLLAMA_GPU_LAYERS=40

# ทรัพยากรสำหรับ WebUI
WEBUI_CPU=2
WEBUI_MEMORY=2G

# ค่า parameters สำหรับโมเดล
MODEL_TEMPERATURE=0.7
MODEL_TOP_P=0.9
MODEL_TOP_K=40



# ข้อมูลสำหรับ WebUI
WEBUI_USER=admin
WEBUI_PASS=adminpass
WEBUI_PORT=3000